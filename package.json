{
  "name": "cardintel-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first business card scanner with AI-powered company & contact intelligence",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite --host\"",
    "dev:https": "concurrently -k -n api,web -c cyan,magenta \"node --watch server/index.js\" \"vite --host --mode https\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "server": "node server/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
