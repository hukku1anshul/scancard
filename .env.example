# Copy to .env and fill in. Every key can also be entered in the app's Settings
# screen (stored only on the device, sent per-request to your own server).

# ---- AI (required for live scans; otherwise Demo mode) -------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google Search grounding + gap-filling via Gemini (on|off)
GROUNDING=on

# ---- Web search (optional; free DuckDuckGo/Bing fallback otherwise) ------------
TAVILY_API_KEY=
SERPAPI_KEY=

# ---- Registries (GLEIF, Wikidata, SEC EDGAR are free and keyless) --------------
# SEC asks for a descriptive User-Agent with contact email
SEC_USER_AGENT=CardIntel/1.0 (you@yourcompany.com)
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_KEY=
# https://opencorporates.com/api_accounts/new
OPENCORPORATES_TOKEN=

# ---- Premium data providers (optional, paid) -----------------------------------
DNB_KEY=
DNB_SECRET=
APOLLO_API_KEY=
PDL_API_KEY=

# ---- CRM sync (optional) -------------------------------------------------------
HUBSPOT_TOKEN=
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=

# ---- Server --------------------------------------------------------------------
PORT=8787
CACHE_TTL_HOURS=72
# CACHE_DIR=./server/.cache
