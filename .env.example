# Server Environment Variables (set in Render Dashboard -> Environment or local .env).
# All users of the app automatically use these server settings without entering keys.

# ---- AI (required for live scans; otherwise Demo mode) -------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Google Search grounding + gap-filling via Gemini (on|off)
GROUNDING=on

# ---- Web search (optional; free DuckDuckGo/Bing fallback otherwise) ------------
TAVILY_API_KEY=
SERPAPI_KEY=

# ---- Registries (India MCA/GST, GLEIF, Wikidata, SEC EDGAR are free & keyless) -
SEC_USER_AGENT=CardIntel/1.0 (you@yourcompany.com)
COMPANIES_HOUSE_KEY=
OPENCORPORATES_TOKEN=

# ---- Premium data providers (optional, paid) -----------------------------------
DNB_KEY=
DNB_SECRET=
APOLLO_API_KEY=
PDL_API_KEY=

# ---- CRM sync (optional, server-wide) ------------------------------------------
HUBSPOT_TOKEN=
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=

# ---- Default Event & Organization Profile (optional, pre-fills for all users) --
DEFAULT_EVENT=
EVENT_MODE=off
AUTO_GEO=on
SENDER_NAME=
SENDER_COMPANY=
SENDER_PHONE=
SENDER_EMAIL=
SENDER_WEBSITE=
SENDER_LINKEDIN=
SENDER_GSTIN=

# ---- Server --------------------------------------------------------------------
PORT=8787
CACHE_TTL_HOURS=72
